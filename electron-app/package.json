{
  "name": "colorlab-pro",
  "version": "1.0.0",
  "description": "Color Lab Pro — Standalone Color Grading for After Effects",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.aeplugins.colorlab-pro",
    "productName": "Color Lab Pro",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "bridge/**", "jsx/**", "renderer/**"],
    "extraFiles": [],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "renderer/icon.ico",
      "uninstallerIcon": "renderer/icon.ico"
    }
  }
}
