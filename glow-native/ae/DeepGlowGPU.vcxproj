  <!-- CUDA pyramid kernels (shared with the Stage-1 parity build). nvcc compiles
       the .cu to an .obj which MSBuild links into the .aex automatically (the
       .obj appears in the CustomBuild Outputs). compute_89/sm_89 = RTX 40-series. -->
  <ItemGroup>
    <CustomBuild Include="..\cuda\glow_cuda.cu">
      <FileType>Document</FileType>
      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">rem Compile the CUDA pyramid kernels (requires nvcc from the CUDA 13.3 toolkit)
"$(CUDA_TOOLKIT)\bin\nvcc.exe" -D_DEBUG -DHAS_CUDA=1 -gencode arch=compute_89,code=sm_89 -use_fast_math -m64 -c -ccbin "$(VC_ExecutablePath_x64_x64)" -Xcompiler /MDd,/EHsc,/W3,/nologo,/Zi -I"$(CUDA_TOOLKIT)\include" -I"$(ProjectDir)..\core" -I"$(ProjectDir)..\cuda" -o "$(IntDir)%(Filename).obj" "%(FullPath)"</Command>
      <Command Condition="'$(Configuration)|$(Platform)'=='Release|x64'">rem Compile the CUDA pyramid kernels (requires nvcc from the CUDA 13.3 toolkit)
"$(CUDA_TOOLKIT)\bin\nvcc.exe" -DHAS_CUDA=1 -gencode arch=compute_89,code=sm_89 -use_fast_math -m64 -c -ccbin "$(VC_ExecutablePath_x64_x64)" -Xcompiler /MD,/EHsc,/W3,/nologo -I"$(CUDA_TOOLKIT)\include" -I"$(ProjectDir)..\core" -I"$(ProjectDir)..\cuda" -o "$(IntDir)%(Filename).obj" "%(FullPath)"</Command>
      <Message Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">Compiling CUDA kernels: %(Filename).cu</Message>
      <Message Condition="'$(Configuration)|$(Platform)'=='Release|x64'">Compiling CUDA kernels: %(Filename).cu</Message>
      <Outputs Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">$(IntDir)%(Filename).obj</Outputs>
      <Outputs Condition="'$(Configuration)|$(Platform)'=='Release|x64'">$(IntDir)%(Filename).obj</Outputs>
      <AdditionalInputs Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">$(ProjectDir)..\cuda\glow_cuda.h;$(ProjectDir)..\core\glow_core.h;$(ProjectDir)..\core\glow_params.h;%(AdditionalInputs)</AdditionalInputs>
      <AdditionalInputs Condition="'$(Configuration)|$(Platform)'=='Release|x64'">$(ProjectDir)..\cuda\glow_cuda.h;$(ProjectDir)..\core\glow_core.h;$(ProjectDir)..\core\glow_params.h;%(AdditionalInputs)</AdditionalInputs>
    </CustomBuild>
  </ItemGroup>
  <ItemGroup>
    <CustomBuild Include="DeepGlowGPUPiPL.r">
      <FileType>Document</FileType>
      <Command Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">cl /I "$(AE_SDK)\Headers" /EP "%(FullPath)" &gt; "$(IntDir)%(Filename).rr"
"$(AE_SDK)\Resources\PiPLtool.exe" "$(IntDir)%(Filename).rr" "$(IntDir)%(Filename).rrc"
